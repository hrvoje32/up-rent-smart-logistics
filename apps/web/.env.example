# Server-only FastAPI connection. Locally use the loopback URL; Vercel Services injects it from a private binding.
# Never use NEXT_PUBLIC_ for this value.
OPTIMIZER_API_URL=http://127.0.0.1:8000

# Supabase SSR authentication. Use a current sb_publishable_ key; never expose a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
